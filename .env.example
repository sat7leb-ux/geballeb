# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used server-side by scripts/seed.ts and by admin-only server actions
# that must bypass RLS (e.g. first-admin bootstrap). NEVER expose this to the
# browser and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used for metadata/Open Graph. Set to your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
